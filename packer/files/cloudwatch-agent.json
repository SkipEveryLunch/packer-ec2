{
  "agent": {
    "run_as_user": "root"
  },
  "logs": {
    "logs_collected": {
      "files": {
        "collect_list": [
          {
            "file_path": "/var/log/puma/puma.log",
            "log_group_name": "/ec2-packer/prd/app",
            "log_stream_name": "{instance_id}/puma",
            "timezone": "UTC"
          }
        ]
      }
    }
  }
}
