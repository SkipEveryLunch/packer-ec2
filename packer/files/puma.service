[Unit]
Description=Puma HTTP Server
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=ec2-user
WorkingDirectory=/var/www/app
Environment=AWS_REGION=ap-northeast-1
Environment=RAILS_LOG_TO_STDOUT=true
EnvironmentFile=/etc/environment
StandardOutput=append:/var/log/puma/puma.log
StandardError=append:/var/log/puma/puma.log
ExecStartPre=/usr/local/bin/with-secrets /usr/bin/bundle exec rails db:migrate
ExecStart=/usr/local/bin/with-secrets /usr/bin/bundle exec puma -C /var/www/app/config/puma.rb
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
