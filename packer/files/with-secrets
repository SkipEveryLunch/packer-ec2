#!/bin/bash
# Fetch flat-JSON secret from Secrets Manager and exec the given command with
# KEY=VALUE injected as env vars. Secret never lands on disk.
# Format contract: {"KEY1":"value1","KEY2":"value2"} — string values only.
set -euo pipefail

JSON=$(aws secretsmanager get-secret-value \
  --secret-id ec2-packer/prd/app-env \
  --query SecretString --output text)

mapfile -t KV < <(jq -r 'to_entries[]|"\(.key)=\(.value)"' <<<"$JSON")
exec env "${KV[@]}" "$@"
